{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "trr.clock",
          "birthYear": 1987,
          "format": "h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "lifeExpectancy": 85,
          "verticalFormat": "h\n—\nmm\nAP"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.indicators"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "io.github.tyrichards.workspaces-jap"
        },
        {
          "id": "io.github.tyrichards.skifree"
        },
        {
          "id": "io.github.tyrichards.omarski"
        }
      ],
      "right": [
        {
          "id": "io.github.tyrichards.orthodox-daily"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "io.github.tyrichards.display-crt"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "trr.battery"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.battery"
  ],
  "cloneSourceRestores": [
    "trr.battery"
  ]
}
